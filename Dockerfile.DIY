# -*- Dockerfile.DIY — 多阶段构建优化版 hermes-agent -*-
#
# 阶段划分:
#   sqlite_build — 编译修复版 SQLite (WAL-reset bug, 见 #70480)
#   uv_source    — 仅拷贝 uv/uvx 二进制
#   node_source  — 构建期 node 26 + npm (替代已 EOL 的 Debian nodejs 20)；
#                  运行期 node/npm 来自 PM store（见 builder 阶段），两者同版本
#   builder      — pnpm install, web/ui-tui 构建, Python venv
#   runtime      — 仅运行时必要产物，无构建工具链
#
# 安全优化（相较于原版 Dockerfile）:
#   1. python:3.14-slim (trixie) + 固定 sha256 digest
#   2. uv:0.11.6-python3.13-trixie 固定 digest (仅拷贝二进制)
#   3. node:26-bookworm-slim 固定 digest
#   4. 多阶段构建：构建工具链（gcc/build-essential/Python dev headers）不进入最终镜像
#   5. pnpm 经 PM store ensure（单一权威），frozen 安装锁定依赖
#   6. 不打包浏览器（有意裁剪）：浏览器工具在容器内如实报不可用。
#      省去 runtime 的 playwright install-deps 系统库（约 80~120MB）；
#      Chromium 二进制本就被多阶段构建丢弃，裁剪只再省构建时间
#   7. Python 依赖层缓存：pyproject.toml/uv.lock 先行 COPY，源码变更不触发重装
#   8. runtime 补充 ffmpeg / openssh-client / docker-cli / tmux；node/npm 走 PM store
#   9. 清理 __pycache__ / .pyc 缩减镜像体积
#  10. 固定 SQLite 库替代 Debian 有 WAL-reset bug 的 libsqlite3.so.0 (同步上游 #70480)
#  11. s6-overlay 改用 curl + --retry 下载 (替代 ADD，规避 CDN 抖动导致构建失败)
#  12. 烘焙树 COPY --link --chmod=a+rX,go-w 一次成型：无 chmod -R/chown -R 巨型层，
#      /opt/hermes 保持 root-owned 不可写（stage2-hook "Immutable install tree" 契约）
# ------------------------------------------------------------------------------

# ===== 阶段 0: SQLite 修复库（上游 #70480）=============================
# Debian 13 自带 SQLite 3.46.1 含上游 WAL-reset 损坏 bug。编译固定共享库
# 供 runtime 使用，避免依赖 trixie 不提供的 backport。
FROM debian:13.4 AS sqlite_build
ARG SQLITE_AUTOCONF_VERSION=3530400
ARG SQLITE_SHA256=0e9483900e92cd5de8fd48d16bf9200145a61f7fd5be542a5ac81d8a9516eb9c
RUN apt-get -o Acquire::Retries=3 update && \
    apt-get -o Acquire::Retries=3 install -y --no-install-recommends \
        build-essential ca-certificates curl && \
    rm -rf /var/lib/apt/lists/* && \
    (curl -fsSL --retry 1 --retry-all-errors --connect-timeout 15 --max-time 60 \
        -o /tmp/sqlite.tar.gz \
        "https://sqlite.org/2026/sqlite-autoconf-${SQLITE_AUTOCONF_VERSION}.tar.gz" || \
     curl -fsSL --retry 3 --retry-all-errors --connect-timeout 15 --max-time 120 \
        -o /tmp/sqlite.tar.gz \
        "https://sources.buildroot.net/sqlite/sqlite-autoconf-${SQLITE_AUTOCONF_VERSION}.tar.gz") && \
    printf '%s  %s\n' "${SQLITE_SHA256}" /tmp/sqlite.tar.gz > /tmp/sqlite.sha256 && \
    sha256sum -c /tmp/sqlite.sha256 && \
    tar -xzf /tmp/sqlite.tar.gz -C /tmp && \
    cd "/tmp/sqlite-autoconf-${SQLITE_AUTOCONF_VERSION}" && \
    CFLAGS="-O2 \
        -DSQLITE_ENABLE_FTS3 \
        -DSQLITE_ENABLE_FTS3_PARENTHESIS \
        -DSQLITE_ENABLE_FTS4 \
        -DSQLITE_ENABLE_FTS5 \
        -DSQLITE_ENABLE_RTREE \
        -DSQLITE_ENABLE_GEOPOLY \
        -DSQLITE_ENABLE_COLUMN_METADATA \
        -DSQLITE_ENABLE_UNLOCK_NOTIFY \
        -DSQLITE_ENABLE_DBSTAT_VTAB \
        -DSQLITE_ENABLE_DBPAGE_VTAB \
        -DSQLITE_ENABLE_MATH_FUNCTIONS \
        -DSQLITE_ENABLE_PREUPDATE_HOOK \
        -DSQLITE_ENABLE_SESSION \
        -DSQLITE_SECURE_DELETE \
        -DSQLITE_THREADSAFE=1 \
        -DSQLITE_MAX_VARIABLE_NUMBER=250000" \
        ./configure --prefix=/opt/sqlite-fixed --disable-static && \
    make -j"$(nproc)" && \
    make install

# ===== 阶段 1: 二进制来源 ==============================================
FROM ghcr.io/astral-sh/uv:0.11.6-python3.13-trixie@sha256:b3c543b6c4f23a5f2df22866bd7857e5d304b67a564f4feab6ac22044dde719b AS uv_source
# Node 26 source stage。Debian trixie 自带的 nodejs 是 20.x（2026-04 EOL）。
# 从上游 node:26 镜像拷贝 node + npm（Hermes 工具链全局固定 Node 26, #4977）。
# 用 bookworm-slim（glibc 2.36）产物，可在 trixie（glibc 2.41）runtime 上运行。
FROM node:26-bookworm-slim@sha256:9e6f9357d371591e32ab6f2d8a26d63bdd0d17c29eee3f4f3e7e454d9634bf73 AS node_source

# ===== 阶段 2: 构建 =====================================================
FROM python:3.14-slim@sha256:51dafde81dbdb6ebde285137a295cf18a47ca95234fe388a343719cb97305b3d AS builder

ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
# PM 工具 store 落在镜像层而非 $HERMES_HOME 数据卷：node/npm 必须随镜像烘焙，
# 否则容器重建后 store 消失，而 HERMES_DISABLE_LAZY_INSTALLS=1 又禁止 PM 补装。
# 上游 Dockerfile:201 用同一变量达成同样目的。
ENV HERMES_RUNTIME_DIR=/opt/hermes/tools

# --- 系统依赖（构建时完整版；node 不再用 apt 安装，改从 node_source 拷贝）---
# 编译工具链 + libolm-dev：uv sync --extra matrix 的 python-olm 在无可用 wheel 时
# 需源码编译（上游 #30399）；python:3.14-slim 不自带编译器与 libolm 头文件。
# 工具链仅存在于 builder，不进最终镜像。
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        python3-dev \
        libffi-dev \
        libolm-dev \
        curl \
        ca-certificates \
        procps \
        git \
        openssh-client \
        ffmpeg \
        ripgrep && \
    rm -rf /var/lib/apt/lists/*

COPY --chmod=0755 --from=uv_source /usr/local/bin/uv /usr/local/bin/uvx /usr/local/bin/
# 构建期 node 26 + 内置 npm（npm 以符号链接恢复，因为源镜像中它是符号链接）。
# npm 只服务本阶段的 photon 侧车 npm ci（前端安装/构建走 pnpm）；运行期改用
# PM store 里锁定同版本（26.x）的那份，见本阶段末尾与 runtime 的 symlink。
COPY --chmod=0755 --from=node_source /usr/local/bin/node /usr/local/bin/
COPY --from=node_source /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm
RUN ln -sf /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm

# 上游已切 pnpm（package.json 拒绝 npm install，root 只用 pnpm-lock.yaml）。
# node-deps.mjs 需要 pnpm CLI 在 PATH；pnpm 12 是原生可执行，symlink 直指其二进制。
COPY pm/ pm/
COPY hermes_constants.py hermes_constants.py
RUN python3 -c 'from pathlib import Path; from pm.install import ensure, installed_package; ensure("pnpm", explicit=True); Path("/usr/local/bin/pnpm").symlink_to(installed_package("pnpm").binary)' && \
    pnpm --version

WORKDIR /opt/hermes

# --- 层缓存：先拷贝包清单 ---
# 根包 + workspace 定义先行：pnpm frozen install 只依赖锁文件与 manifests
# （web/ui-tui/apps/*/hermes-ink 是 pnpm workspaces，见 pnpm-workspace.yaml）。
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY web/package.json web/
COPY ui-tui/package.json ui-tui/
COPY ui-tui/packages/hermes-ink/ ui-tui/packages/hermes-ink/
COPY apps/shared/ apps/shared/
COPY scripts/build/node-deps.mjs scripts/build/pnpm-lock.mjs scripts/build/electron-runtime.mjs scripts/build/

# node-deps.mjs 做 pnpm frozen lockfile 安装（同上游 Dockerfile），覆盖
# web/ui-tui 两个 workspace。
RUN node scripts/build/node-deps.mjs --source /opt/hermes --workspace ui-tui --workspace web

# --- Photon iMessage 侧车依赖烘焙（同步上游；镜像不可变，首连 lazy npm ci 会撞 EROFS）---
COPY plugins/platforms/photon/sidecar/package.json \
     plugins/platforms/photon/sidecar/package-lock.json \
     plugins/platforms/photon/sidecar/patch-spectrum-mixed-attachments.mjs \
     plugins/platforms/photon/sidecar/
RUN cd plugins/platforms/photon/sidecar && \
    npm ci --no-audit --fetch-retries=5 && \
    npm cache clean --force

# --- Python 依赖缓存层（与源码分离）---
COPY pyproject.toml uv.lock ./
RUN touch ./README.md
RUN uv sync --frozen --no-install-project --no-cache \
    --extra all --extra messaging --extra otlp \
    --extra anthropic --extra bedrock --extra azure-identity \
    --extra matrix --extra google-chat --extra fal --extra documents

# --- 前端构建（与 Python 源码独立缓存：纯 Python 改动不重跑 web/ui-tui build）---
# 构建产物 hermes_cli/web_dist/ 与 ui-tui/dist/ 已被 .dockerignore 排除出上下文，
# 后续 COPY . . 不会用本地陈旧产物覆盖镜像内新构建结果。
COPY web/ web/
COPY ui-tui/ ui-tui/
COPY apps/shared/ apps/shared/
COPY scripts/build/ scripts/build/
RUN cd web && pnpm run build && cd ../ui-tui && pnpm run build

# --- 源码 ---
# node_modules/.venv 存活靠 .dockerignore 排除 + COPY 目录合并不删除语义；
# --link 使本层与父层解耦，--chmod 在拷贝时烙好最终权限，省掉遍历 ~30k 文件的
# chmod -R 整层重写（上游 #49113）。
# a+rX,go-w：hermes 只读+可执行，root 保留写 —— 与 stage2-hook "Immutable install
# tree" 契约一致（烘焙树刻意 root-owned 不可写，防止会话自改安装树）。
COPY --link --chmod=a+rX,go-w . .
RUN find /opt/hermes \( -type d -name __pycache__ -exec rm -rf {} + \) -o \
        \( -type f -name '*.pyc' -delete \) || true

# --- 链接 hermes-agent（依赖已缓存，仅需创建 editable link）---
RUN uv pip install --no-cache-dir --no-deps -e "."

# --- PM 工具 store：把 node/npm 装进镜像层 ---
# 上游 b63c138d78 裁定 "Hermes 只用自己打包的 node/npm/npx/uv，缺失时绝不回落
# 用户 PATH"（native-addon ABI 与 npm cache 混用会坏）。find_node_executable()
# 因此只读 PM store，_tui_node_bin() 再经 pm.ensure() 拿 PATH —— store 里没有
# node 时 ensure() 直接抛 InstallError，dashboard 建新对话必挂（PTY 1011）。
#
# 本镜像的 store 由 HERMES_RUNTIME_DIR 钉在 /opt/hermes/tools（镜像层，非
# /opt/data 数据卷），所以 node 随镜像烘焙，容器重建后依然可解析。
# explicit=True 标记这是有意的安装命令，绕开 lazy-install 策略；node 由
# walk(['npm']) 带入，无需单列。这里用 pm.install.ensure 而非 pm.ensure：后者在
# 非 PM-runtime 进程里会 _request() 再引导一整套独立 runtime（连带装 uv+python），
# 而 builder 只需要就地写入 store。
COPY hermes_cli/__init__.py hermes_cli/runtime_state.py hermes_cli/
RUN python3 -c 'from pm.install import ensure; ensure("npm", explicit=True)'
# 脚本走 stdin（python3 -）而非 heredoc：Dockerfile 解析器会把 heredoc 体里的
# 缩进行当成新指令（run 106 报 "FROM requires either one or three arguments"）。
RUN python3 - <<'PY'
from pathlib import Path
from hermes_constants import find_node_executable
for cmd in ("node", "npm", "npx"):
    resolved = find_node_executable(cmd)
    assert resolved and Path(resolved).is_file(), f"{cmd} 未落进 PM store: {resolved}"
    print(cmd, resolved)
PY

# ===== 阶段 3: 运行时 ====================================================
FROM python:3.14-slim@sha256:51dafde81dbdb6ebde285137a295cf18a47ca95234fe388a343719cb97305b3d AS runtime

ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV HERMES_WEB_DIST=/opt/hermes/hermes_cli/web_dist
# 指向构建期烘焙的 TUI bundle，让 TUI 启动器走 prebuilt 快速路径（跳过 npm install）
ENV HERMES_TUI_DIR=/opt/hermes/ui-tui
ENV HERMES_HOME=/opt/data
ENV HERMES_WRITE_SAFE_ROOT=/opt/data
# 运行期密封：不按需安装任何新依赖（opt-in extra、插件依赖、uvx MCP 均不可用），
# 需要新依赖时只能重建镜像 —— 有意换取可预测的只读运行时。
ENV HERMES_DISABLE_LAZY_INSTALLS=1
# 与 builder 同一 store 路径：node/npm 由 builder 装进 /opt/hermes/tools 并随
# /opt/hermes 一起 COPY 过来。缺这行的话 store_root() 会回落到 $HERMES_HOME/tools
# （/opt/data 数据卷），容器重建后 node 消失，pm.ensure() 随之抛 InstallError。
ENV HERMES_RUNTIME_DIR=/opt/hermes/tools
# 构建 helper 用系统 Python；TUI gateway 子进程需要密封的 venv 运行时
ENV HERMES_PYTHON=/opt/hermes/.venv/bin/python
# Xfce/dbus/display 锁需要确定性的 per-UID 运行时目录；容器无 logind，
# /tmp/hermes-runtime 由下方预建（0700），stage2-hook 信任并 chown
ENV XDG_RUNTIME_DIR=/tmp/hermes-runtime
ENV PATH="/opt/hermes/bin:/opt/hermes/.venv/bin:/opt/data/.local/bin:${PATH}"

# --- SQLite WAL-reset 修复（同步上游 #70480）---
# 保持公开库名不变，使系统解释器与 uv venv 均解析到替换库
COPY --from=sqlite_build /opt/sqlite-fixed/lib/libsqlite3.so.3.53.4 /usr/local/lib/
RUN ln -sf libsqlite3.so.3.53.4 /usr/local/lib/libsqlite3.so.0 && \
    ln -sf libsqlite3.so.3.53.4 /usr/local/lib/libsqlite3.so && \
    printf '/usr/local/lib\n' > /etc/ld.so.conf.d/000-sqlite-fixed.conf && \
    ldconfig && \
    python3 -c "import sqlite3, sys; \
v = sqlite3.sqlite_version_info; \
sys.exit(f'linked SQLite {sqlite3.sqlite_version} still has the WAL-reset bug') if v < (3, 51, 3) else None; \
db = sqlite3.connect(':memory:'); \
db.execute(\"CREATE VIRTUAL TABLE docs USING fts5(content, tokenize='trigram')\"); \
db.execute(\"INSERT INTO docs VALUES ('hermes')\"); \
sys.exit('SQLite FTS5 trigram self-test failed') if db.execute(\"SELECT count(*) FROM docs WHERE docs MATCH 'erm'\").fetchone()[0] != 1 else None; \
db.close()"

# --- 运行时最小依赖 ---
# iputils-ping：agent 终端 ping；libatomic1：node 部分场景依赖，
# python:3.14-slim 默认不带。tmux：hermes-agent 技能的交互 PTY 配方
# （tmux send-keys/capture-pane）需要它，运行期用户无法自行补装。
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        curl \
        ca-certificates \
        iputils-ping \
        libatomic1 \
        procps \
        git \
        ffmpeg \
        openssh-client \
        ripgrep \
        docker-cli \
        tmux \
        xz-utils && \
    rm -rf /var/lib/apt/lists/*

RUN useradd -u 10000 -m -d /opt/data hermes

# X socket 目录：Xvnc 会自建（/tmp 为 1777），预建保持 HERMES_UID 重映射
# 启动间的属主确定性。XDG_RUNTIME_DIR（上方 ENV）落在世界可写 /tmp 下且
# 具可预测名，以 root 属主 0700 交付，stage2-hook 信任该目录并 chown 给
# hermes 用户（避免两实例争用共享 $HERMES_HOME/.cache 锁）。
RUN mkdir -p /tmp/.X11-unix && chmod 1777 /tmp/.X11-unix
RUN mkdir -p /tmp/hermes-runtime && chmod 0700 /tmp/hermes-runtime

# ---------- s6-overlay install ----------
# 用 curl 而非 ADD：ADD 在解析期求值（无法做 ARG/TARGETARCH 替换）且不能重试，
# CDN 抖动会废掉整次 15-45 分钟构建。curl -fsSL --retry 3 可自愈。所有包仍做校验和校验。
ARG TARGETARCH
ARG S6_OVERLAY_VERSION=3.2.3.0
ARG S6_OVERLAY_NOARCH_SHA256=b720f9d9340efc8bb07528b9743813c836e4b02f8693d90241f047998b4c53cf
ARG S6_OVERLAY_X86_64_SHA256=a93f02882c6ed46b21e7adb5c0add86154f01236c93cd82c7d682722e8840563
ARG S6_OVERLAY_AARCH64_SHA256=0952056ff913482163cc30e35b2e944b507ba1025d78f5becbb89367bf344581
ARG S6_OVERLAY_SYMLINKS_SHA256=a60dc5235de3ecbcf874b9c1f18d73263ab99b289b9329aa950e8729c4789f0e
RUN set -eu; \
    case "${TARGETARCH:-amd64}" in \
        amd64) s6_arch="x86_64"; s6_arch_sha="${S6_OVERLAY_X86_64_SHA256}" ;; \
        arm64) s6_arch="aarch64"; s6_arch_sha="${S6_OVERLAY_AARCH64_SHA256}" ;; \
        *) echo "Unsupported TARGETARCH=${TARGETARCH} for s6-overlay" >&2; exit 1 ;; \
    esac; \
    base="https://github.com/just-containers/s6-overlay/releases/download/v${S6_OVERLAY_VERSION}"; \
    curl -fsSL --retry 3 -o /tmp/s6-overlay-noarch.tar.xz \
        "${base}/s6-overlay-noarch.tar.xz"; \
    curl -fsSL --retry 3 -o /tmp/s6-overlay-symlinks-noarch.tar.xz \
        "${base}/s6-overlay-symlinks-noarch.tar.xz"; \
    curl -fsSL --retry 3 -o /tmp/s6-overlay-arch.tar.xz \
        "${base}/s6-overlay-${s6_arch}.tar.xz"; \
    { \
        printf '%s  %s\n' "${S6_OVERLAY_NOARCH_SHA256}" /tmp/s6-overlay-noarch.tar.xz; \
        printf '%s  %s\n' "${s6_arch_sha}" /tmp/s6-overlay-arch.tar.xz; \
        printf '%s  %s\n' "${S6_OVERLAY_SYMLINKS_SHA256}" /tmp/s6-overlay-symlinks-noarch.tar.xz; \
    } > /tmp/s6-overlay.sha256; \
    sha256sum -c /tmp/s6-overlay.sha256; \
    tar -C / -Jxpf /tmp/s6-overlay-noarch.tar.xz; \
    tar -C / -Jxpf /tmp/s6-overlay-arch.tar.xz; \
    tar -C / -Jxpf /tmp/s6-overlay-symlinks-noarch.tar.xz; \
    rm /tmp/s6-overlay-*.tar.xz /tmp/s6-overlay.sha256

# ---------- 兼容 shim ----------
# 兼容仍引用旧 /usr/bin/tini 入口的编排模板（Hostinger 目录、NAS compose 等）。
# 直接符号链接 /init 会把 tini 参数（如 -g）透传给 rc.init 导致启动循环（#66679）。
COPY --chmod=0755 docker/tini-shim.sh /usr/bin/tini

# 登录 shell 重读 /etc/profile 会重置 PATH；此脚本把上方 ENV PATH 的三个目录
# 补回，使 `docker exec -it <c> bash -l` 等登录 shell 仍能找到 hermes/venv。
COPY --chmod=0644 docker/profile-hermes-path.sh /etc/profile.d/hermes.sh
# --link + --chmod 在拷贝时一次成型：避免 chmod -R/chown -R 把整棵 ~2-3GB 的树
# （venv + node_modules）重写进新层、使最终镜像近乎翻倍（#49113）。
# 烘焙树刻意保持 root-owned 且 hermes 不可写（stage2-hook "Immutable install tree"
# 契约）；可变状态全在 $HERMES_HOME，运行期按需安装已禁用（密封运行时）。
COPY --link --chmod=a+rX,go-w --from=builder /opt/hermes /opt/hermes/

# --- runtime 补齐 node/npm ---
# 指向 builder 阶段装进 PM store 的那一份（/opt/hermes/tools，随上面的 COPY 过来），
# 不再从 node_source 拷实体：find_node_executable() 只认 PM store，两处必须是同一个
# node，否则 pm.ensure("npm") 仍会因 store 空而抛 InstallError。
RUN python3 - <<'PY'
import sys
sys.path.insert(0, "/opt/hermes")
from pathlib import Path
from hermes_constants import find_node_executable
for cmd in ("node", "npm", "npx"):
    link = Path("/usr/local/bin") / cmd
    link.unlink(missing_ok=True)
    link.symlink_to(find_node_executable(cmd))
PY
RUN node --version && npm --version

# ---------- s6-overlay service wiring ----------
COPY docker/s6-rc.d/ /etc/s6-overlay/s6-rc.d/
RUN mkdir -p /etc/cont-init.d && \
    printf '#!/command/with-contenv sh\nexec /opt/hermes/docker/stage2-hook.sh\n' \
        > /etc/cont-init.d/01-hermes-setup && \
    chmod +x /etc/cont-init.d/01-hermes-setup
COPY --chmod=0755 docker/cont-init.d/015-supervise-perms /etc/cont-init.d/015-supervise-perms
COPY --chmod=0755 docker/cont-init.d/02-reconcile-profiles /etc/cont-init.d/02-reconcile-profiles

# ---------- 权限与安装方式标记 ----------
# .install_method 标记烙在代码树（/opt/hermes）而非 $HERMES_HOME（共享数据卷可能
# 与宿主机安装共享，烙在数据卷会误伤宿主机安装的 hermes update）。
# 以 root 启动：stage2 hook 需要 usermod/groupmod + chown 数据卷；随后每个被监督
# 服务经 s6-setuidgid hermes 降权。HERMES_UID 未设时服务以默认 hermes 用户(UID 10000)运行。
USER root
RUN mkdir -p /opt/hermes/bin && \
    cp /opt/hermes/docker/hermes-exec-shim.sh /opt/hermes/bin/hermes && \
    chmod 0755 /opt/hermes /opt/hermes/bin/hermes && \
    printf 'docker\n' > /opt/hermes/.install_method

# ---------- 构建 provenance ----------
# .dockerignore 排除 .git，容器内 git rev-parse 拿不到 SHA；版本溯源由下方
# install-stamp.json 承担（hermes_cli/version_info.py 读它）。CI 经 HERMES_GIT_SHA
# build-arg 传入真实 SHA；本地构建不传则回退全零（version_info 视为 unknown）。
ARG HERMES_GIT_SHA=
# ---------- PM 运行时 marker（供 pm.runtime._resident_runtime 定位驻留解释器）----------
# distribution=docker 的 install-stamp 必须带 pmRuntime 绝对路径 + 该目录下
# pm-runtime.json（python/sitePackages 相对键），否则 TUI 子进程 boot 时
# _resident_runtime() 抛 "packaged PM runtime is missing" → 聊天无法启动。
# 本镜像驻留运行时即 /opt/hermes/.venv 本身（HERMES_PYTHON 指向它）：用 venv
# 自带解释器经 sysconfig 精确算出 site-packages 相对路径，跨 Python 版本稳健。
RUN /opt/hermes/.venv/bin/python - <<'PY'
import json, sysconfig
from pathlib import Path
venv = Path("/opt/hermes/.venv")
site = Path(sysconfig.get_paths()["purelib"])
marker = {"python": "bin/python3", "sitePackages": site.relative_to(venv).as_posix()}
(venv / "pm-runtime.json").write_text(json.dumps(marker, indent=2) + "\n", encoding="utf-8")
print("pm-runtime marker:", dict(marker))
PY
# 标准 install-stamp.json：hermes_cli/version_info.py 经 pm.paths.install_stamp_path()
# 读取此文件作为版本溯源权威（commit/distribution/updateMechanism）。CI 经
# HERMES_GIT_SHA 传入真实 SHA；本地构建未传时用全零 fallback（version_info 将其
# 视为 unknown，与原版回退语义一致）。脚本将 repo 根（/opt/hermes）插入 sys.path，
# 所需 hermes_cli/pm 模块均已随上方 COPY --from=builder 落入 runtime。
RUN python3 /opt/hermes/scripts/write_install_stamp.py \
    --output /opt/hermes/install-stamp.json \
    --commit "${HERMES_GIT_SHA:-0000000000000000000000000000000000000000}" \
    --source ci --distribution docker --update-mechanism external \
    --pm-runtime /opt/hermes/.venv

# ---------- docker exec 特权降级 shim + entrypoint dispatcher ----------
# hermes-exec-shim：`docker exec <c> hermes ...` 以 root 运行时降权到 hermes 用户，
# 避免 auth.json 等文件被写成 root 所有而让监督网关读不到。
# entrypoint-dispatch.sh：镜像真占 PID 1 时 exec /init；被平台 init 包裹（Fly、
# --init 等）时回退直接 bootstrap，保证前台命令可用（#38349）。
COPY --chmod=0755 docker/entrypoint-dispatch.sh /opt/hermes/docker/entrypoint-dispatch.sh

VOLUME ["/opt/data"]

ENTRYPOINT ["/opt/hermes/docker/entrypoint-dispatch.sh"]
CMD []
